# Скопіюй цей файл як .env і заповни своїми значеннями.
# Файл .env у git не комітиться (він в .gitignore).

# Google OAuth Client ID (публічний, віддається в браузер).
# Як отримати: https://console.cloud.google.com → APIs & Services → Credentials
REACT_APP_GOOGLE_CLIENT_ID=

# URL бекенду. Для локальної розробки лиши значення нижче.
REACT_APP_API_URL=http://127.0.0.1:8000/api
