# Скопіюй цей файл як .env і заповни своїми значеннями.
# Файл .env у git не комітиться (він в .gitignore).

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Default — SQLite (db.sqlite3) для локальної розробки.
# При запуску через docker-compose це значення перезаписується на postgres.
# DATABASE_URL=postgres://autohub:autohub@db:5432/autohub

# Google OAuth Client ID (публічний, не секрет — але краще тримати в .env).
# Як отримати: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_OAUTH_CLIENT_ID=

# Sentry (необов'язково). При відсутності DSN — Sentry не ініціалізується.
SENTRY_DSN=
SENTRY_ENV=production
