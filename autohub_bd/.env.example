# Скопіюй цей файл як .env і заповни своїми значеннями.
# Файл .env у git не комітиться (він в .gitignore).

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Якщо ввімкнеш Postgres у settings.py — заповни DATABASE_URL.
# Інакше Django використає SQLite (db.sqlite3).
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google OAuth Client ID (публічний, не секрет — але краще тримати в .env).
# Як отримати: https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_OAUTH_CLIENT_ID=
